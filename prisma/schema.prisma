generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EventMode {
  IN_PERSON
  VIRTUAL
  HYBRID
  UNKNOWN
}

enum EventType {
  INFO_SESSION
  TECH_TALK
  COFFEE_CHAT
  INTERVIEW
  CAREER_FAIR
  DEADLINE
  WORKSHOP
  OTHER
}

enum SourceKind {
  WEB_PAGE
  RSS
  ICAL
  API
  SUBMISSION
}

enum RunStatus {
  PENDING
  RUNNING
  SUCCEEDED
  PARTIAL
  FAILED
}

enum SubmissionStatus {
  PENDING
  PROCESSING
  APPROVED
  REJECTED
  FAILED
}

model Company {
  id             String   @id @default(cuid())
  name           String
  normalizedName String   @unique
  websiteUrl     String?
  logoUrl        String?
  events         Event[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Event {
  id                   String        @id @default(cuid())
  slug                 String        @unique
  title                String
  normalizedTitle      String
  description          String?
  startAt              DateTime
  endAt                DateTime?
  timezone             String        @default("America/New_York")
  location             String?
  mode                 EventMode     @default(UNKNOWN)
  type                 EventType     @default(OTHER)
  careerCategories     String[]
  registrationUrl      String?
  registrationDeadline DateTime?
  extractionConfidence Float?
  discoveredAt         DateTime      @default(now())
  isPublished          Boolean       @default(false)
  isMock               Boolean       @default(false)
  companyId            String?
  company              Company?      @relation(fields: [companyId], references: [id], onDelete: SetNull)
  sources              EventSource[]
  saves                SavedEvent[]
  createdAt            DateTime      @default(now())
  updatedAt            DateTime      @updatedAt

  @@index([startAt, isPublished])
  @@index([companyId, startAt])
  @@index([type, startAt])
  @@index([mode, startAt])
  @@index([normalizedTitle, startAt])
}

model Source {
  id              String           @id @default(cuid())
  name            String
  url             String           @unique
  kind            SourceKind       @default(WEB_PAGE)
  enabled         Boolean          @default(true)
  config          Json             @default("{}")
  lastCheckedAt   DateTime?
  nextCheckAt     DateTime?
  eventSources    EventSource[]
  ingestionRuns   IngestionRun[]
  submittedEvents SubmittedEvent[]
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([enabled, nextCheckAt])
}

model EventSource {
  eventId       String
  sourceId      String
  sourceUrl     String
  sourceEventId String?
  firstSeenAt   DateTime @default(now())
  lastSeenAt    DateTime @updatedAt
  rawPayload    Json?
  event         Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  source        Source   @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([eventId, sourceId, sourceUrl])
  @@index([sourceUrl])
}

model User {
  id        String       @id @default(cuid())
  email     String?      @unique
  deviceId  String?      @unique
  saves     SavedEvent[]
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
}

model SavedEvent {
  userId    String
  eventId   String
  createdAt DateTime @default(now())
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  event     Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@id([userId, eventId])
  @@index([eventId])
}

model SubmittedEvent {
  id          String           @id @default(cuid())
  url         String
  status      SubmissionStatus @default(PENDING)
  submitterIp String?
  error       String?
  extracted   Json?
  sourceId    String?
  source      Source?          @relation(fields: [sourceId], references: [id], onDelete: SetNull)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([status, createdAt])
}

model IngestionRun {
  id              String    @id @default(cuid())
  sourceId        String
  status          RunStatus @default(PENDING)
  startedAt       DateTime?
  finishedAt      DateTime?
  discoveredCount Int       @default(0)
  createdCount    Int       @default(0)
  updatedCount    Int       @default(0)
  errorCount      Int       @default(0)
  errorLog        Json?
  source          Source    @relation(fields: [sourceId], references: [id], onDelete: Cascade)
  createdAt       DateTime  @default(now())

  @@index([sourceId, createdAt])
  @@index([status, createdAt])
}

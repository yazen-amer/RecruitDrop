{
  "name": "cornell-recruiting-radar",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "postinstall": "prisma generate",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "node --env-file=.env --import tsx prisma/seed.ts",
    "ingest": "node --env-file=.env --import tsx scripts/ingest.ts",
    "events:reclassify": "node --env-file=.env --import tsx scripts/reclassify-events.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "lucide-react": "^0.468.0",
    "next": "16.3.4",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "eslint": "9.39.4",
    "eslint-config-next": "16.3.4",
    "typescript": "5.9.3",
    "prisma": "6.19.3",
    "tsx": "^4.23.13",
    "vitest": "^3.2.4"
  },
  "type": "module",
  "packageManager": "pnpm@11.19.0"
}
